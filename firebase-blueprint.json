{
  "entities": {
    "AdminRecord": {
      "title": "AdminRecord",
      "description": "Authorized owner administrator record for LIFEGRAPH financial console.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "role": {
          "type": "string",
          "enum": ["OWNER_ADMIN"],
          "maxLength": 32
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["uid", "role", "createdAt"]
    },
    "JobRecord": {
      "title": "JobRecord",
      "description": "AI and engineering job tracked from discovery to delivery, client payment verification, and payout.",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "clientName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "platform": {
          "type": "string",
          "enum": ["Upwork", "Fiverr", "Direct Contract", "GitHub Bounty", "Retainer"],
          "maxLength": 40
        },
        "category": {
          "type": "string",
          "enum": ["Web Application", "Bug Fixing", "Full-Stack Feature", "Security Audit", "API Integration"],
          "maxLength": 40
        },
        "stage": {
          "type": "string",
          "enum": ["DISCOVERED", "PROPOSAL_READY", "IN_PROGRESS", "DELIVERED_INVOICED", "PAID_VERIFIED", "REFUNDED"],
          "maxLength": 32
        },
        "estimatedBdt": {
          "type": "number"
        },
        "verifiedGrossBdt": {
          "type": "number"
        },
        "platformFeeBdt": {
          "type": "number"
        },
        "netEarnedBdt": {
          "type": "number"
        },
        "paymentProofRef": {
          "type": "string",
          "maxLength": 160
        },
        "aiSummary": {
          "type": "string",
          "maxLength": 2000
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "ownerId",
        "title",
        "clientName",
        "platform",
        "category",
        "stage",
        "estimatedBdt",
        "verifiedGrossBdt",
        "platformFeeBdt",
        "netEarnedBdt",
        "paymentProofRef",
        "aiSummary",
        "createdAt",
        "updatedAt"
      ]
    },
    "LedgerEntry": {
      "title": "LedgerEntry",
      "description": "Immutable financial ledger record for verified payments, platform fees, operational expenses, refunds, and withdrawals.",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "txnReference": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "entryType": {
          "type": "string",
          "enum": ["CREDIT_PAYMENT", "DEBIT_PLATFORM_FEE", "DEBIT_EXPENSE", "DEBIT_REFUND", "DEBIT_WITHDRAWAL"],
          "maxLength": 32
        },
        "source": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        },
        "currency": {
          "type": "string",
          "enum": ["BDT", "USD"],
          "maxLength": 10
        },
        "grossAmountBdt": {
          "type": "number"
        },
        "feeAmountBdt": {
          "type": "number"
        },
        "netAmountBdt": {
          "type": "number"
        },
        "reconciliationStatus": {
          "type": "string",
          "enum": ["RECONCILED", "PENDING_CLEARANCE", "DISPUTED"],
          "maxLength": 32
        },
        "proofReference": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "relatedJobId": {
          "type": "string",
          "maxLength": 128
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "ownerId",
        "txnReference",
        "entryType",
        "source",
        "description",
        "currency",
        "grossAmountBdt",
        "feeAmountBdt",
        "netAmountBdt",
        "reconciliationStatus",
        "proofReference",
        "relatedJobId",
        "createdAt",
        "updatedAt"
      ]
    },
    "PayoutMethod": {
      "title": "PayoutMethod",
      "description": "Configured bKash, Bangladesh Bank, or intermediary payout destination with masked credentials.",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "providerType": {
          "type": "string",
          "enum": ["BANK_BEFTN", "BANK_NPSB", "PAYONEER", "WISE", "SWIFT_WIRE"],
          "maxLength": 32
        },
        "providerName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "accountHolderName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "maskedAccountNumber": {
          "type": "string",
          "minLength": 4,
          "maxLength": 60
        },
        "accountType": {
          "type": "string",
          "enum": ["PERSONAL", "MERCHANT", "SAVINGS", "CURRENT", "BUSINESS"],
          "maxLength": 32
        },
        "bankBranch": {
          "type": "string",
          "maxLength": 120
        },
        "routingNumber": {
          "type": "string",
          "maxLength": 40
        },
        "isDefault": {
          "type": "boolean"
        },
        "verificationStatus": {
          "type": "string",
          "enum": ["VERIFIED", "PENDING_VERIFICATION", "SUSPENDED"],
          "maxLength": 32
        },
        "minWithdrawalBdt": {
          "type": "number"
        },
        "autoPayoutEnabled": {
          "type": "boolean"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "ownerId",
        "providerType",
        "providerName",
        "accountHolderName",
        "maskedAccountNumber",
        "accountType",
        "bankBranch",
        "routingNumber",
        "isDefault",
        "verificationStatus",
        "minWithdrawalBdt",
        "autoPayoutEnabled",
        "createdAt",
        "updatedAt"
      ]
    },
    "WithdrawalRequest": {
      "title": "WithdrawalRequest",
      "description": "Auditable withdrawal transaction via Manual Transfer or Automatic bKash/Bank API Disbursement.",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "payoutMethodId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "providerSummary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 140
        },
        "executionMode": {
          "type": "string",
          "enum": ["MANUAL_TRANSFER", "AUTO_API_DISBURSEMENT"],
          "maxLength": 32
        },
        "requestedAmountBdt": {
          "type": "number"
        },
        "feeAmountBdt": {
          "type": "number"
        },
        "netPayoutBdt": {
          "type": "number"
        },
        "status": {
          "type": "string",
          "enum": ["PENDING_APPROVAL", "AWAITING_MANUAL_TRANSFER", "PROCESSING_API", "COMPLETED", "FAILED", "CANCELLED"],
          "maxLength": 32
        },
        "idempotencyKey": {
          "type": "string",
          "minLength": 6,
          "maxLength": 120
        },
        "transferReference": {
          "type": "string",
          "maxLength": 160
        },
        "failureReason": {
          "type": "string",
          "maxLength": 300
        },
        "retryCount": {
          "type": "number"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "ownerId",
        "payoutMethodId",
        "providerSummary",
        "executionMode",
        "requestedAmountBdt",
        "feeAmountBdt",
        "netPayoutBdt",
        "status",
        "idempotencyKey",
        "transferReference",
        "failureReason",
        "retryCount",
        "createdAt",
        "updatedAt"
      ]
    },
    "AuditLog": {
      "title": "AuditLog",
      "description": "Immutable security and financial governance audit entry.",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "actor": {
          "type": "string",
          "enum": ["OWNER_ADMIN", "AI_AGENT_GUARDED", "SYSTEM_WEBHOOK"],
          "maxLength": 32
        },
        "action": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "targetType": {
          "type": "string",
          "enum": ["JOB", "LEDGER", "PAYOUT_METHOD", "WITHDRAWAL", "SECURITY_POLICY"],
          "maxLength": 32
        },
        "targetId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "details": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "ownerId",
        "actor",
        "action",
        "targetType",
        "targetId",
        "details",
        "createdAt"
      ]
    }
  },
  "firestore": {
    "/admins/{adminId}": {
      "schema": { "$ref": "#/entities/AdminRecord" },
      "description": "Owner administrator access control list."
    },
    "/jobs/{jobId}": {
      "schema": { "$ref": "#/entities/JobRecord" },
      "description": "AI discovered and executed paid work records."
    },
    "/ledger_entries/{entryId}": {
      "schema": { "$ref": "#/entities/LedgerEntry" },
      "description": "Immutable financial ledger of verified credits and debits."
    },
    "/payout_methods/{methodId}": {
      "schema": { "$ref": "#/entities/PayoutMethod" },
      "description": "Owner bKash and Bangladesh Bank payout destinations."
    },
    "/withdrawals/{withdrawalId}": {
      "schema": { "$ref": "#/entities/WithdrawalRequest" },
      "description": "Manual and API payout withdrawal requests and reconciliation records."
    },
    "/audit_logs/{logId}": {
      "schema": { "$ref": "#/entities/AuditLog" },
      "description": "Append-only audit trail for financial and payout configuration actions."
    }
  }
}
